# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://cernly.ai

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/cernly

# ── Clerk (Auth) ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# ── Anthropic (AI) ───────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Google PageSpeed ──────────────────────────────────────────────────────────
# Get a free key at: https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=AIza...

# ── BrightData (proxy for blocked sites) ─────────────────────────────────────
BRIGHTDATA_API_KEY=...
# Zone name in your BrightData account (create a Web Unlocker zone called "cernly")

# ── DigitalOcean Spaces (desktop screenshot storage) ─────────────────────────
# Standard Storage bucket with CDN enabled. Objects are stored with private ACL.
# Presigned GET URLs are generated against the S3 API endpoint (not the CDN hostname).
DO_SPACES_KEY=your_spaces_access_key_id
DO_SPACES_SECRET=your_spaces_secret_access_key
DO_SPACES_REGION=nyc3
DO_SPACES_BUCKET=cernly-screenshots
DO_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
